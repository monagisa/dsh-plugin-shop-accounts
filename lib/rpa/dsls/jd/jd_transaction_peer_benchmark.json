{
  "schemaVersion": "multi-platform-rpa-execution-new.dsl-spec.v1",
  "id": "jd_transaction_peer_benchmark",
  "verified": false,
  "domains": [
    "经营总览"
  ],
  "platform": "jd",
  "description": "固定昨天采集JD transaction industry benchmark core metrics。",
  "conditions": {
    "time": {
      "kind": "fixed",
      "value": "day"
    }
  },
  "template": {
    "schemaVersion": "agentwork.rpa.atomic.v1",
    "name": "JD transaction industry benchmark core metrics",
    "description": "Prepare page for metric collection: jd_transaction_industry_ranking_rpa",
    "defaults": {
      "timeoutMs": 15000,
      "retries": 1,
      "continueOnError": false,
      "stepGapMs": 200
    },
    "steps": [
      {
        "id": "jd_transaction_industry_ranking_rpa:goto",
        "action": "goto",
        "url": "https://jdsz.jd.com/szweb/view/tradeAnalysis/tradeSummary.html",
        "waitUntil": "domcontentloaded",
        "timeoutMs": 30000,
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "jd.dismiss-known-dialog",
            "target": [
              {
                "by": "css",
                "value": ".close-modal",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'ux-modal-dialog')]//*[contains(@class,'close-modal')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is(.jmt-dialog-wrapper, .all-dialog) :is(.close-modal, .close-icon)",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "state": "visible",
            "timeoutMs": 10000,
            "onError": "continue",
            "retries": 0
          },
          {
            "action": "click",
            "optional": true,
            "id": "jd.dismiss-known-dialog.click",
            "target": [
              {
                "by": "css",
                "value": ".close-modal",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'ux-modal-dialog')]//*[contains(@class,'close-modal')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is(.jmt-dialog-wrapper, .all-dialog) :is(.close-modal, .close-icon)",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "onError": "continue",
            "retries": 0,
            "timeoutMs": 1000
          }
        ]
      },
      {
        "id": "jd_transaction_industry_ranking_rpa:wait-selector",
        "action": "waitFor",
        "target": [
          {
            "by": "css",
            "value": "body",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 25000,
        "recovery": "auto",
        "optional": true,
        "onError": "continue"
      },
      {
        "action": "waitFor",
        "target": [
          {
            "by": "text",
            "value": "昨天",
            "match": "exact",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='昨天'])[1]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='昨天'][not(.//*[normalize-space(.)='昨天'])])[1]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 30000,
        "retries": 0,
        "onError": "continue",
        "id": "jd_transaction_industry_ranking_rpa:wait-quick-range-visible",
        "recovery": "auto",
        "optional": true
      },
      {
        "action": "click",
        "target": [
          {
            "by": "text",
            "value": "昨天",
            "match": "exact",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='昨天'])[1]",
            "nth": 0
          }
        ],
        "timeoutMs": 5000,
        "retries": 0,
        "onError": "fail",
        "id": "jd_transaction_industry_ranking_rpa:click-quick-range"
      },
      {
        "action": "waitForLoadState",
        "timeoutMs": 2500,
        "retries": 0,
        "onError": "continue",
        "loadState": "networkidle",
        "id": "jd_transaction_industry_ranking_rpa:wait-data-refresh-after-range"
      },
      {
        "action": "waitFor",
        "target": [
          {
            "by": "text",
            "value": "核心指标",
            "match": "exactThenContains",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'核心指标')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "id": "jd_transaction_industry_ranking_rpa:wait-core-metrics-visible",
        "recovery": "auto",
        "optional": true
      },
      {
        "action": "scrollIntoView",
        "target": [
          {
            "by": "text",
            "value": "核心指标",
            "match": "exactThenContains",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'核心指标')]",
            "nth": 0
          }
        ],
        "timeoutMs": 8000,
        "onError": "continue",
        "id": "jd_transaction_industry_ranking_rpa:scroll-core-metrics"
      },
      {
        "action": "waitFor",
        "target": [
          {
            "by": "text",
            "value": "同行同级均值",
            "match": "contains",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'同行同级均值')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "id": "jd_transaction_industry_ranking_rpa:wait-industry-benchmark-visible",
        "recovery": "auto",
        "optional": true
      },
      {
        "action": "waitFor",
        "target": [
          {
            "by": "text",
            "value": "同行上级均值",
            "match": "contains",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'同行上级均值')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "id": "jd_transaction_industry_ranking_rpa:wait-upper-industry-benchmark-visible",
        "recovery": "auto",
        "optional": true
      },
      {
        "action": "waitForLoadState",
        "timeoutMs": 2000,
        "retries": 0,
        "onError": "continue",
        "loadState": "networkidle",
        "id": "jd_transaction_industry_ranking_rpa:settle-before-read"
      },
      {
        "id": "jd_transaction_industry_ranking_rpa:read-card-text",
        "action": "readText",
        "target": [
          {
            "by": "css",
            "value": "body",
            "nth": 0
          }
        ],
        "readMode": "innerText",
        "trim": true,
        "outputKey": "jd_transaction_industry_ranking_body_text",
        "recovery": "auto"
      }
    ]
  },
  "collection": {
    "artifacts": [
      {
        "role": "business",
        "kind": "raw_envelope",
        "pointer": ""
      }
    ]
  }
}
