{
  "schemaVersion": "multi-platform-rpa-execution-new.dsl-spec.v1",
  "id": "jd_abnormal_product",
  "verified": false,
  "domains": [
    "商品供给",
    "服务履约"
  ],
  "platform": "jd",
  "description": "采集京东商智异常商品当前页面数据。",
  "conditions": {},
  "template": {
    "schemaVersion": "agentwork.rpa.atomic.v1",
    "name": "京东商智异常商品",
    "description": "采集京东商智异常商品当前页面数据。",
    "defaults": {
      "timeoutMs": 8000,
      "retries": 0,
      "continueOnError": true,
      "stepGapMs": 200
    },
    "steps": [
      {
        "action": "waitTimeout",
        "id": "abnormal_product:页面间隔",
        "ms": 300
      },
      {
        "action": "goto",
        "id": "abnormal_product:打开商智-异常商品",
        "url": "https://jdsz.jd.com/szweb/view/product/abnormal-product-temp.html",
        "waitUntil": "domcontentloaded",
        "timeoutMs": 30000,
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "jd.generic.dismiss-dialog",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "state": "visible",
            "timeoutMs": 10000,
            "onError": "continue",
            "retries": 0
          },
          {
            "action": "click",
            "optional": true,
            "id": "jd.generic.dismiss-dialog.click",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "onError": "continue",
            "retries": 0,
            "timeoutMs": 1000
          }
        ]
      },
      {
        "action": "waitForLoadState",
        "id": "abnormal_product:等待DOM加载",
        "loadState": "domcontentloaded"
      },
      {
        "action": "waitTimeout",
        "id": "abnormal_product:等待页面初始渲染",
        "ms": 2500
      },
      {
        "action": "waitTimeout",
        "id": "abnormal_product:等待日期筛选后渲染",
        "ms": 1000
      },
      {
        "action": "press",
        "id": "abnormal_product:向下滚动-1",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "abnormal_product:等待懒加载-1",
        "ms": 500
      },
      {
        "action": "press",
        "id": "abnormal_product:向下滚动-2",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "abnormal_product:等待懒加载-2",
        "ms": 500
      },
      {
        "action": "press",
        "id": "abnormal_product:向下滚动-3",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "abnormal_product:等待懒加载-3",
        "ms": 500
      },
      {
        "action": "readText",
        "id": "abnormal_product:读取页面可见文本",
        "target": [
          {
            "by": "css",
            "value": "body",
            "nth": 0
          }
        ],
        "readMode": "innerText",
        "trim": true,
        "outputKey": "abnormal_product_body_text",
        "recovery": "auto"
      }
    ]
  },
  "collection": {
    "artifacts": [
      {
        "role": "business",
        "kind": "raw_envelope",
        "pointer": ""
      }
    ]
  }
}
