{
  "schemaVersion": "multi-platform-rpa-execution-new.dsl-spec.v1",
  "id": "jd_ads_platform_overview",
  "verified": false,
  "domains": [
    "运营推广"
  ],
  "platform": "jd",
  "description": "采集京准通首页当前页面数据。",
  "conditions": {
    "time": {
      "kind": "fixed",
      "value": "day"
    }
  },
  "template": {
    "schemaVersion": "agentwork.rpa.atomic.v1",
    "name": "京东京准通首页",
    "description": "采集京准通首页当前页面数据。",
    "defaults": {
      "timeoutMs": 8000,
      "retries": 0,
      "continueOnError": true,
      "stepGapMs": 200,
      "conditionTimeoutMs": 2000
    },
    "steps": [
      {
        "action": "waitTimeout",
        "id": "jzt_home:页面间隔",
        "ms": 300
      },
      {
        "action": "goto",
        "id": "jzt_home:打开京准通-首页",
        "url": "https://jzt.jd.com/home/",
        "waitUntil": "domcontentloaded",
        "timeoutMs": 30000,
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "jd.jzt.dismiss-known-dialog",
            "target": [
              {
                "by": "css",
                "value": ".close-modal",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'ux-modal-dialog')]//*[contains(@class,'close-modal')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "state": "visible",
            "timeoutMs": 10000,
            "onError": "continue",
            "retries": 0
          },
          {
            "action": "click",
            "optional": true,
            "id": "jd.jzt.dismiss-known-dialog.click",
            "target": [
              {
                "by": "css",
                "value": ".close-modal",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'ux-modal-dialog')]//*[contains(@class,'close-modal')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "onError": "continue",
            "retries": 0,
            "timeoutMs": 1000
          }
        ]
      },
      {
        "action": "waitForLoadState",
        "id": "jzt_home:等待DOM加载",
        "loadState": "domcontentloaded"
      },
      {
        "action": "waitTimeout",
        "id": "jzt_home:等待页面初始渲染",
        "ms": 2500
      },
      {
        "action": "when",
        "id": "jzt_home:关闭首屏广告弹窗",
        "condition": {
          "kind": "element",
          "state": "visible",
          "target": [
            {
              "by": "css",
              "value": ".close-modal",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//*[contains(@class,'ux-modal-dialog')]//*[contains(@class,'close-modal')]",
              "nth": 0
            }
          ],
          "timeoutMs": 2000
        },
        "then": [
          {
            "action": "click",
            "id": "jzt_home:点击广告弹窗关闭按钮",
            "target": [
              {
                "by": "css",
                "value": ".close-modal",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'ux-modal-dialog')]//*[contains(@class,'close-modal')]",
                "nth": 0
              }
            ],
            "timeoutMs": 5000,
            "retries": 1,
            "onError": "continue"
          },
          {
            "action": "waitTimeout",
            "id": "jzt_home:等待广告弹窗关闭",
            "ms": 1200
          }
        ],
        "onError": "continue"
      },
      {
        "action": "clickAndWait",
        "id": "jzt_home:选择日期-昨天",
        "target": [
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='快车关键词和顶部店铺的数据']/following::*[normalize-space(.)='昨天' and not(self::input)][1])"
          },
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='今天']/following-sibling::*[normalize-space(.)='昨天'][1])"
          },
          {
            "by": "text",
            "value": "昨天",
            "match": "exact",
            "nth": 0
          }
        ],
        "onError": "continue",
        "waitAfterClick": {
          "type": "timeout",
          "ms": 1800
        },
        "timeoutMs": 3500,
        "retries": 0
      },
      {
        "action": "waitTimeout",
        "id": "jzt_home:等待日期筛选后渲染",
        "ms": 1000
      },
      {
        "action": "press",
        "id": "jzt_home:向下滚动-1",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "jzt_home:等待懒加载-1",
        "ms": 500
      },
      {
        "action": "press",
        "id": "jzt_home:向下滚动-2",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "jzt_home:等待懒加载-2",
        "ms": 500
      },
      {
        "action": "press",
        "id": "jzt_home:向下滚动-3",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "jzt_home:等待懒加载-3",
        "ms": 500
      },
      {
        "action": "readText",
        "id": "jzt_home:读取页面可见文本",
        "target": [
          {
            "by": "css",
            "value": "body",
            "nth": 0
          }
        ],
        "readMode": "innerText",
        "trim": true,
        "outputKey": "jzt_home_body_text",
        "recovery": "auto"
      }
    ]
  },
  "collection": {
    "schedule": {
      "mode": "snapshot"
    },
    "artifacts": [
      {
        "role": "business",
        "kind": "raw_envelope",
        "pointer": ""
      }
    ]
  }
}
