{
  "schemaVersion": "multi-platform-rpa-execution-new.dsl-spec.v1",
  "id": "jd_product_traffic_analysis",
  "verified": false,
  "domains": [
    "流量转化",
    "商品供给"
  ],
  "needsParams": true,
  "platform": "jd",
  "description": "京东商智单品分析-流量分析：选择近30天后切「流量分析」Tab，下载流量结构（二级渠道）、关键词来源、付费流量和地域来源四份报表。流量结构下载需在级联菜单选择「二级渠道」；菜单用空白处点击关闭，其他三个按钮直接触发下载。",
  "conditions": {
    "time": {
      "kind": "fixed",
      "value": "month"
    },
    "filter": {
      "kind": "required",
      "fields": {
        "productIds": {
          "type": "stringArray",
          "minItems": 1,
          "maxItems": 1
        }
      },
      "bindings": {
        "${productId}": "$filter.productId"
      }
    }
  },
  "template": {
    "schemaVersion": "agentwork.rpa.atomic.v1",
    "name": "京东商智单品分析-流量分析",
    "description": "单品分析页 -> 选时间档 -> 流量分析Tab -> 下载流量结构分析(二级渠道)/关键词来源分析/付费流量分析/地域来源。四个下载点均为 downloadFile，各自独立 outputKey。",
    "defaults": {
      "timeoutMs": 12000,
      "retries": 0,
      "continueOnError": true,
      "stepGapMs": 250,
      "conditionTimeoutMs": 2500
    },
    "steps": [
      {
        "action": "goto",
        "id": "sp_traffic:进入单品分析页",
        "description": "直接按站点自身生成的 URL 格式导航；dateValue 只带 currentKey，携带空 currentValue 数组会导致页面白屏。",
        "url": "https://jdsz.jd.com/szweb/view/single-product-analysis.html?id={productId}&proType=spu&dateValue=%7B%22currentKey%22%3A%22todayRealtime%22%7D&channel=all&from=productDetail",
        "waitUntil": "domcontentloaded",
        "timeoutMs": 30000,
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "jd.generic.dismiss-dialog",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "state": "visible",
            "timeoutMs": 10000,
            "onError": "continue",
            "retries": 0
          },
          {
            "action": "click",
            "optional": true,
            "id": "jd.generic.dismiss-dialog.click",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "onError": "continue",
            "retries": 0,
            "timeoutMs": 1000
          }
        ]
      },
      {
        "action": "waitForLoadState",
        "id": "sp_traffic:等待DOM加载",
        "loadState": "domcontentloaded"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:等待首屏渲染",
        "ms": 5000
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:等待一级Tab出现",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-tabs-item') and normalize-space()='流量分析']",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[contains(@class,'tabs-item') or contains(@class,'tab-item') or @role='tab'][normalize-space(.)='流量分析'])[1]"
          },
          {
            "by": "text",
            "value": "流量分析",
            "match": "exact",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 30000,
        "onError": "continue",
        "recovery": "auto",
        "description": "整个 DSL 的入口探测步。定位器不单依赖平台私有 class（jmt-tabs-item），补角色/类名模糊匹配与纯文本兜底。本步只做可见性探测，成败由后续 Tab 激活校验与下载步骤判定，故为 continue。",
        "optional": true
      },
      {
        "action": "clickAndWait",
        "id": "sp_traffic:选择时间档-近30天",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-combo-date-picker')]//*[contains(@class,'jmt-combo-date-picker-list-tag') and normalize-space()='近30天']",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[contains(@class,'date-picker')]//*[contains(@class,'date-picker-list-tag')][normalize-space(.)='近30天'])[1]"
          },
          {
            "by": "xpath",
            "value": "(//*[contains(@class,'jmt-combo-date-picker-list-tag')][normalize-space(.)='近30天'])[1]"
          }
        ],
        "force": true,
        "waitAfterClick": {
          "type": "timeout",
          "ms": 3500
        },
        "timeoutMs": 20000,
        "retries": 2,
        "onError": "continue",
        "description": "选择「近30天」快捷周期；定位依次使用 jmt-combo-date-picker 路径、date-picker 类名和 li 文本候选。"
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:校验时间档已选中-近30天",
        "target": [
          {
            "by": "xpath",
            "value": "//*[contains(@class,'jmt-combo-date-picker-list-tag-select') and normalize-space()='近30天']",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 15000,
        "onError": "continue",
        "optional": true
      },
      {
        "action": "clickAndWait",
        "id": "sp_traffic:切换到流量分析Tab",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-tabs-item') and normalize-space()='流量分析']",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[contains(@class,'tabs-item') or contains(@class,'tab-item') or @role='tab'][normalize-space(.)='流量分析'])[1]"
          },
          {
            "by": "text",
            "value": "流量分析",
            "match": "exact",
            "nth": 0
          }
        ],
        "force": true,
        "waitAfterClick": {
          "type": "timeout",
          "ms": 4000
        },
        "timeoutMs": 20000,
        "retries": 2,
        "onError": "continue",
        "description": "定位器三级兜底，不单依赖 jmt-tabs-item。continue 而非 fail：Tab 未切换成功时后续「等待流量分析Tab激活」仍会拦截，且各下载步骤本身为 continue，不应让本步单点抖动终止整个单品采集。"
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:等待流量分析Tab激活",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-tabs-active-item') and normalize-space()='流量分析']",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "optional": true
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:等待流量结构分析区块渲染",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='流量结构分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 30000,
        "recovery": "auto",
        "optional": true,
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:等待流量数据加载",
        "ms": 2500
      },
      {
        "action": "scrollIntoView",
        "id": "sp_traffic:滚动到流量结构分析",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='流量结构分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "block": "center",
        "timeoutMs": 15000,
        "onError": "continue"
      },
      {
        "action": "click",
        "id": "sp_traffic:展开流量结构分析下载下拉",
        "description": "该按钮不直接下载，而是展开 jmt Cascader 级联下拉（一级/二级/三级/四级渠道）。",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='流量结构分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "timeoutMs": 20000,
        "retries": 1,
        "onError": "continue"
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:等待渠道下拉展开",
        "description": "选项外层可点击节点必须用 data-component-name='DropdownOption' 锚定；用 class 包含 jmt-dropdown-option 会命中3个嵌套节点导致 LOCATOR_AMBIGUOUS。",
        "target": [
          {
            "by": "xpath",
            "value": "//div[@data-component-name='DropdownOption' and .//span[normalize-space()='二级渠道']]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "optional": true
      },
      {
        "action": "downloadFile",
        "id": "sp_traffic:下载流量结构分析-二级渠道",
        "target": [
          {
            "by": "xpath",
            "value": "//div[@data-component-name='DropdownOption' and .//span[normalize-space()='二级渠道']]",
            "nth": 0
          }
        ],
        "timeoutMs": 90000,
        "retries": 1,
        "onError": "continue",
        "outputKey": "jdSpTrafficStructureL2File"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:流量结构下载后等待",
        "ms": 2500
      },
      {
        "action": "click",
        "id": "[try]sp_traffic:关闭残留渠道下拉",
        "description": "该级联下拉 Escape 无效，只能点页面空白处关闭；点区块标题即可。",
        "target": [
          {
            "by": "xpath",
            "value": "(//div[contains(@class,'jmt-card-v2')]//*[normalize-space()='流量结构分析'])[1]"
          }
        ],
        "force": true,
        "timeoutMs": 8000,
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:关闭下拉后等待",
        "ms": 1200
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:等待关键词来源分析区块",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='关键词来源分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 30000,
        "onError": "continue",
        "optional": true
      },
      {
        "action": "scrollIntoView",
        "id": "sp_traffic:滚动到关键词来源分析",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='关键词来源分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "block": "center",
        "timeoutMs": 15000,
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:关键词区块滚动后等待",
        "ms": 1500
      },
      {
        "action": "downloadFile",
        "id": "sp_traffic:下载关键词来源分析",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='关键词来源分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "timeoutMs": 90000,
        "retries": 1,
        "onError": "continue",
        "outputKey": "jdSpTrafficKeywordFile"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:关键词下载后等待",
        "ms": 2500
      },
      {
        "action": "press",
        "id": "[try]sp_traffic:向下滚动加载付费流量区块",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:等待付费流量懒加载",
        "ms": 1500
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:等待付费流量分析区块",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='付费流量分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 30000,
        "onError": "continue",
        "optional": true
      },
      {
        "action": "scrollIntoView",
        "id": "sp_traffic:滚动到付费流量分析",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='付费流量分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "block": "center",
        "timeoutMs": 15000,
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:付费流量滚动后等待",
        "ms": 1500
      },
      {
        "action": "downloadFile",
        "id": "sp_traffic:下载付费流量分析",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='付费流量分析']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "timeoutMs": 90000,
        "retries": 1,
        "onError": "continue",
        "outputKey": "jdSpTrafficPaidFile"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:付费流量下载后等待",
        "ms": 2500
      },
      {
        "action": "press",
        "id": "[try]sp_traffic:向下滚动加载地域来源区块",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:等待地域来源懒加载",
        "ms": 1500
      },
      {
        "action": "waitFor",
        "id": "sp_traffic:等待地域来源区块",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='地域来源']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 30000,
        "onError": "continue",
        "optional": true
      },
      {
        "action": "scrollIntoView",
        "id": "sp_traffic:滚动到地域来源",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='地域来源']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "block": "center",
        "timeoutMs": 15000,
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:地域来源滚动后等待",
        "ms": 1500
      },
      {
        "action": "downloadFile",
        "id": "sp_traffic:下载地域来源",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'jmt-card-v2') and .//*[normalize-space()='地域来源']]//button[contains(.,'下载数据')]",
            "nth": 0
          }
        ],
        "timeoutMs": 90000,
        "retries": 1,
        "onError": "continue",
        "outputKey": "jdSpTrafficRegionFile"
      },
      {
        "action": "waitTimeout",
        "id": "sp_traffic:地域来源下载后等待",
        "ms": 2000
      },
      {
        "action": "readText",
        "id": "sp_traffic:读取流量分析页面文本",
        "target": [
          {
            "by": "css",
            "value": "body",
            "nth": 0
          }
        ],
        "readMode": "innerText",
        "trim": true,
        "outputKey": "sp_traffic_body_text",
        "recovery": "auto"
      }
    ]
  },
  "collection": {
    "import": {
      "subject_mode": "single",
      "report_sources": true
    }
  }
}
