{
  "schemaVersion": "multi-platform-rpa-execution-new.dsl-spec.v1",
  "id": "jd_service_overview",
  "verified": false,
  "domains": [
    "服务履约"
  ],
  "platform": "jd",
  "description": "固定近30天采集京东商智服务概览页面。",
  "conditions": {
    "time": {
      "kind": "fixed",
      "value": "month"
    }
  },
  "template": {
    "schemaVersion": "agentwork.rpa.atomic.v1",
    "name": "京东商智服务概览",
    "description": "固定近30天采集京东商智服务概览页面。",
    "defaults": {
      "timeoutMs": 8000,
      "retries": 0,
      "continueOnError": true,
      "stepGapMs": 200
    },
    "steps": [
      {
        "action": "waitTimeout",
        "id": "service_summary:页面间隔",
        "ms": 300
      },
      {
        "action": "goto",
        "id": "service_summary:打开商智-服务概览",
        "url": "https://jdsz.jd.com/szweb/view/service/service-summary.html",
        "waitUntil": "domcontentloaded",
        "timeoutMs": 30000,
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "jd.generic.dismiss-dialog",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "state": "visible",
            "timeoutMs": 10000,
            "onError": "continue",
            "retries": 0
          },
          {
            "action": "click",
            "optional": true,
            "id": "jd.generic.dismiss-dialog.click",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "onError": "continue",
            "retries": 0,
            "timeoutMs": 1000
          }
        ]
      },
      {
        "action": "waitForLoadState",
        "id": "service_summary:等待DOM加载",
        "loadState": "domcontentloaded"
      },
      {
        "action": "waitTimeout",
        "id": "service_summary:等待页面初始渲染",
        "ms": 2500
      },
      {
        "action": "clickAndWait",
        "id": "service_summary:选择日期-近30天",
        "description": "选择「近30天」快捷周期。该文本采集步骤 onError=continue；未命中时沿用页面默认口径，并由下游如实记录。",
        "target": [
          {
            "by": "xpath",
            "value": "//*[contains(@class,'jmt-combo-date-picker-list-tag') and normalize-space(.)='近30天']",
            "nth": 0
          },
          {
            "by": "text",
            "value": "近30天",
            "match": "exact",
            "nth": 0
          },
          {
            "by": "text",
            "value": "30天",
            "match": "contains",
            "nth": 0
          }
        ],
        "onError": "continue",
        "waitAfterClick": {
          "type": "timeout",
          "ms": 1500
        },
        "timeoutMs": 3000,
        "retries": 0
      },
      {
        "action": "waitTimeout",
        "id": "service_summary:等待日期筛选后渲染",
        "ms": 1000
      },
      {
        "action": "press",
        "id": "service_summary:向下滚动-1",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "service_summary:等待懒加载-1",
        "ms": 500
      },
      {
        "action": "press",
        "id": "service_summary:向下滚动-2",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "service_summary:等待懒加载-2",
        "ms": 500
      },
      {
        "action": "press",
        "id": "service_summary:向下滚动-3",
        "key": "PageDown",
        "onError": "continue"
      },
      {
        "action": "waitTimeout",
        "id": "service_summary:等待懒加载-3",
        "ms": 500
      },
      {
        "action": "readText",
        "id": "service_summary:读取页面可见文本",
        "target": [
          {
            "by": "css",
            "value": "body",
            "nth": 0
          }
        ],
        "readMode": "innerText",
        "trim": true,
        "outputKey": "service_summary_body_text",
        "recovery": "auto"
      }
    ]
  },
  "collection": {
    "artifacts": [
      {
        "role": "business",
        "kind": "raw_envelope",
        "pointer": ""
      }
    ]
  }
}
