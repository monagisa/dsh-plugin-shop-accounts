{
  "schemaVersion": "dsh-shop-accounts/dsl/v1",
  "id": "tb_store_core_daily",
  "platform": "taobao",
  "description": "生意参谋「店铺经营核心日报」模板下载（30 天，60 指标；移植自 上游 现行 store_core_daily）",
  "conditions": {},
  "template": {
    "defaults": {
      "timeoutMs": 15000,
      "retries": 1,
      "continueOnError": false,
      "stepGapMs": 200
    },
    "steps": [
      {
        "id": "goto-template",
        "action": "goto",
        "url": "https://sycm.taobao.com/lyone/auto_analysis/datafetch/create?insertType=sycm&layoutHide=1&useDebug=false&activeKey=template"
      },
      {
        "id": "wait-page",
        "action": "waitTimeout",
        "ms": 7000
      },
      {
        "id": "wait-item",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'lyone-template-item')][.//div[contains(normalize-space(.),'店铺经营核心日报')]]"
          }
        ]
      },
      {
        "id": "after-wait-item",
        "action": "waitTimeout",
        "ms": 500
      },
      {
        "id": "scroll-item",
        "action": "scrollIntoView",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'lyone-template-item')][.//div[contains(normalize-space(.),'店铺经营核心日报')]]"
          }
        ]
      },
      {
        "id": "wait-download-btn",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "(//div[contains(@class,'lyone-template-item')][.//div[contains(normalize-space(.),'店铺经营核心日报')]]//button[normalize-space(.)='下载'])[1]"
          }
        ]
      },
      {
        "id": "assert-download-btn",
        "action": "assertElement",
        "target": [
          {
            "by": "xpath",
            "value": "(//div[contains(@class,'lyone-template-item')][.//div[contains(normalize-space(.),'店铺经营核心日报')]]//button[normalize-space(.)='下载'])[1]"
          }
        ]
      },
      {
        "id": "download-report",
        "action": "downloadFile",
        "target": [
          {
            "by": "xpath",
            "value": "(//div[contains(@class,'lyone-template-item')][.//div[contains(normalize-space(.),'店铺经营核心日报')]]//button[normalize-space(.)='下载'])[1]"
          }
        ]
      }
    ]
  },
  "collection": {
    "import": {
      "subject_mode": "single"
    }
  },
  "domains": [
    "经营总览"
  ],
  "verified": false
}
