{
  "schemaVersion": 1,
  "id": "tb_traffic_source_excel",
  "verified": true,
  "domains": [
    "流量转化"
  ],
  "platform": "taobao",
  "description": "淘宝流量来源 Excel 导出：在生意参谋首页用页内同步请求直接取导出接口的 xls 字节并落盘（不点「生成报表/下载报表」，也不依赖浏览器下载事件）。",
  "conditions": {
    "time": {
      "kind": "range",
      "bindings": {
        "{dateRange}": "$condition.encoded"
      }
    }
  },
  "template": {
    "description": "打开生意参谋首页 → 页内请求导出接口取字节 → 记录最终地址",
    "steps": [
      {
        "id": "tb_traffic_source_excel:goto",
        "action": "goto",
        "url": "https://sycm.taobao.com/portal/home.htm",
        "waitUntil": "domcontentloaded",
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "taobao.generic.dismiss-dialog",
            "target": [
              {
                "by": "css",
                "value": ".next-dialog-close"
              },
              {
                "by": "css",
                "value": ".J_Quick2Static"
              }
            ],
            "timeoutMs": 5000,
            "onError": "continue"
          }
        ]
      },
      {
        "id": "tb_traffic_source_excel:wait-shell",
        "action": "waitTimeout",
        "ms": 2000
      },
      {
        "id": "tb_traffic_source_excel:fetch-excel",
        "action": "fetchFile",
        "url": "https://sycm.taobao.com/flow/gray/excel.do?_path_=v4/excel/shop/source/platform/summay/v4&dateType=day&dateRange={dateRange}&crowdType=all&needCate=true",
        "outputKey": "trafficSourceExcel",
        "timeoutMs": 90000
      },
      {
        "id": "tb_traffic_source_excel:read-url",
        "action": "readPageUrl",
        "outputKey": "finalUrl"
      }
    ],
    "artifacts": [
      {
        "role": "business",
        "kind": "download_ref",
        "output_key": "trafficSourceExcel",
        "extensions": [
          "xls"
        ]
      }
    ]
  },
  "collection": {
    "import": {
      "subject_mode": "single"
    }
  }
}
