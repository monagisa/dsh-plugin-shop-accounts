{
  "schemaVersion": "multi-platform-rpa-execution-new.dsl-spec.v1",
  "id": "tb_ads_product_promotion",
  "verified": true,
  "domains": [
    "运营推广"
  ],
  "platform": "taobao",
  "description": "本轮唯一报表任务名贯穿创建、等待与下载，不复用同名历史任务。进入阿里妈妈 report/item_promotion，使用 .mxgc-calendar-rangepicker/.mx-trigger-label 日期控件；按报表名称、日期范围和生成状态定位本轮任务，再通过 downloadFile 返回确定的文件路径。",
  "conditions": {
    "time": {
      "kind": "range",
      "bindings": {
        "{taobaoAdsRequestedStart}": "$condition.start",
        "{taobaoAdsRequestedEnd}": "$condition.end"
      }
    },
    "filter": {
      "kind": "required",
      "bindings": {
        "{runId}": "$run.id"
      }
    }
  },
  "template": {
    "schemaVersion": "agentwork.rpa.atomic.v1",
    "name": "阿里妈妈商品推广明细报表下载",
    "description": "阿里妈妈商品推广明细报表下载：进入 report/item_promotion，选择日期范围，创建本轮唯一报表名称的下载任务，并通过刷新任务列表下载本次商品推广明细。名称固定，存在同名历史任务时无法仅凭名称确认本次任务。",
    "defaults": {
      "timeoutMs": 15000,
      "retries": 1,
      "continueOnError": false,
      "stepGapMs": 200
    },
    "steps": [
      {
        "id": "taobao_ads_item_promotion_rpa:goto",
        "action": "goto",
        "url": "https://one.alimama.com/index.html#!/report/item_promotion?rptType=item_promotion&isRequestedQztDefaultSet=1&startTime={taobaoAdsRequestedStart}&endTime={taobaoAdsRequestedEnd}",
        "waitUntil": "domcontentloaded",
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "alimama.dismiss-known-dialog",
            "target": [
              {
                "by": "css",
                "value": "[id^='wrapper_dlg_'] [data-spm-click*='dialog_close']",
                "nth": 0
              },
              {
                "by": "css",
                "value": "[id^='wrapper_dlg_'] [mx-view*='icon=close']",
                "nth": 0
              },
              {
                "by": "css",
                "value": ".next-dialog-close",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'next-dialog') or contains(@class,'next-overlay')]//*[contains(@class,'next-dialog-close')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ".ant-modal-close, .semi-modal-close, [role='dialog'] button[aria-label='Close']",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "state": "visible",
            "timeoutMs": 10000,
            "onError": "continue",
            "retries": 0
          },
          {
            "action": "click",
            "optional": true,
            "id": "alimama.dismiss-known-dialog.click",
            "target": [
              {
                "by": "css",
                "value": "[id^='wrapper_dlg_'] [data-spm-click*='dialog_close']",
                "nth": 0
              },
              {
                "by": "css",
                "value": "[id^='wrapper_dlg_'] [mx-view*='icon=close']",
                "nth": 0
              },
              {
                "by": "css",
                "value": ".next-dialog-close",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'next-dialog') or contains(@class,'next-overlay')]//*[contains(@class,'next-dialog-close')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ".ant-modal-close, .semi-modal-close, [role='dialog'] button[aria-label='Close']",
                "nth": 0
              },
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "onError": "continue",
            "retries": 0,
            "timeoutMs": 1000
          }
        ]
      },
      {
        "id": "taobao_ads_item_promotion_rpa:wait-initial",
        "action": "waitTimeout",
        "ms": 12000
      },
      {
        "id": "taobao_ads_item_promotion_rpa:read-login-guard-url",
        "action": "readPageUrl",
        "outputKey": "login_guard_entry_url",
        "onError": "continue",
        "retries": 0,
        "description": "登录诊断取证：首屏 settle 后记录实际落地 URL 到 outputs.login_guard_entry_url。goto 返回的是请求 URL 而非跳转后 URL，故必须在此显式读取；供守卫漏报时结合真实 URL 判别登录失效/无权限/页面改版。onError=continue，读取失败不阻断。"
      },
      {
        "id": "taobao_ads_item_promotion_rpa:login-page-detected",
        "action": "when",
        "condition": {
          "kind": "element",
          "target": [
            {
              "by": "xpath",
              "value": "//input[contains(@placeholder,'账号名/邮箱/手机号')]",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//iframe[@id='alibaba-login-box']",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//iframe[contains(@src,'login.taobao.com/member/login.jhtml')]",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//input[@id='fm-login-id']",
              "nth": 0
            }
          ],
          "state": "visible",
          "timeoutMs": 8000
        },
        "then": [
          {
            "id": "taobao_ads_item_promotion_rpa:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效",
            "action": "assertElement",
            "state": "hidden",
            "target": [
              {
                "by": "xpath",
                "value": "//input[contains(@placeholder,'账号名/邮箱/手机号')]",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//iframe[@id='alibaba-login-box']",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//iframe[contains(@src,'login.taobao.com/member/login.jhtml')]",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//input[@id='fm-login-id']",
                "nth": 0
              }
            ],
            "timeoutMs": 500,
            "onError": "fail",
            "recovery": "none",
            "description": "与第一层 when 同候选（三形态最小信号集）：when 命中的元素必然可见，hidden 断言必然失败 → LOGIN_REQUIRED 短路，不依赖页面营销文案。 主文档候选含 //input[@id='fm-login-id']，与第一层 when 同候选。"
          }
        ],
        "onError": "continue",
        "description": "登录守卫第一层（主文档三形态最小信号集，2026-10-14 收敛）：形态A 整页跳转登录→账号输入框占位符；形态B 生意参谋/千牛 Havana mini-login→iframe#alibaba-login-box；形态C 阿里妈妈万相台→iframe src 含 login.taobao.com/member/login.jhtml。8s 窗口吸收 magix 异步渲染延迟；命中即进 then 短路 LOGIN_REQUIRED。同形态冗余候选（密码/短信页签、家族特有文本、#alibaba-login-iframe、mini_login、havanalogin、style=mini、mx-view login-iframe、body.login-page）已删除。 追加主文档 //input[@id='fm-login-id']：兜住 passport 整页登录密码/短信两种页签且不依赖 placeholder 文案；该 id 在阿里妈妈/生意参谋/千牛位于跨域 iframe 内，主文档 XPath 不可达，故不误报。"
      },
      {
        "id": "taobao_ads_item_promotion_rpa:login-iframe-form-detected",
        "action": "when",
        "description": "登录守卫第二层（穿框兜底）：按协议-21 §7.4 将 frame 置于 condition 内部，穿入跨域登录 iframe（Havana #alibaba-login-box / 阿里妈妈 login.taobao.com mini 页）探测 #fm-login-id；命中即未登录短路 LOGIN_REQUIRED。frame 不放 when 顶层：when 仅有 condition/then 专属字段、无 target 语义，顶层 frame 会被忽略，导致条件仍在主文档求值、跨域表单不可达而本层永不命中。",
        "condition": {
          "kind": "element",
          "target": [
            {
              "by": "xpath",
              "value": "//input[@id='fm-login-id']",
              "nth": 0
            }
          ],
          "state": "visible",
          "timeoutMs": 3000,
          "frame": [
            {
              "by": "css",
              "value": "iframe#alibaba-login-box",
              "nth": 0
            },
            {
              "by": "css",
              "value": "iframe[src*='login.taobao.com/member/login.jhtml']",
              "nth": 0
            }
          ]
        },
        "then": [
          {
            "id": "taobao_ads_item_promotion_rpa:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效_跨域登录框内表单",
            "action": "assertElement",
            "state": "hidden",
            "target": [
              {
                "by": "xpath",
                "value": "//input[@id='fm-login-id']",
                "nth": 0
              }
            ],
            "timeoutMs": 500,
            "onError": "fail",
            "recovery": "none",
            "description": "与 condition 同作用域：when 命中即 #fm-login-id 在跨域 iframe 内可见，同 frame 的 hidden 断言必然失败 → onError=fail 短路 LOGIN_REQUIRED。不再断言主文档三容器 hidden：其『必然可见』假设与本层『第一层未命中』前提互斥，容器不可见/不存在时 hidden 反而通过，断言记 success、onError=fail 不生效，未登录被静默放行。",
            "frame": [
              {
                "by": "css",
                "value": "iframe#alibaba-login-box",
                "nth": 0
              },
              {
                "by": "css",
                "value": "iframe[src*='login.taobao.com/member/login.jhtml']",
                "nth": 0
              }
            ]
          }
        ],
        "onError": "continue"
      },
      {
        "id": "taobao_ads_item_promotion_rpa:wait-item-promotion-shell",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'商品报表') or contains(normalize-space(.),'商品数据明细') or contains(normalize-space(.),'数据汇总周期') or contains(normalize-space(.),'下载报表')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 30000,
        "onError": "continue",
        "description": "",
        "optional": true
      },
      {
        "action": "when",
        "id": "taobao_ads_item_promotion_rpa:关闭营销弹窗",
        "condition": {
          "kind": "element",
          "state": "visible",
          "target": [
            {
              "by": "css",
              "value": ".next-dialog-close",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//*[contains(@class,'next-dialog') or contains(@class,'next-overlay')]//*[contains(@class,'next-dialog-close') or contains(@class,'close')]",
              "nth": 0
            },
            {
              "by": "css",
              "value": ".ant-modal-close, .semi-modal-close, [role='dialog'] button[aria-label='Close'], [role='dialog'] button[aria-label='关闭']",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//*[contains(@class,'modal') or contains(@class,'dialog') or @role='dialog']//*[contains(@class,'close') or @aria-label='Close' or @aria-label='关闭' or @title='关闭']",
              "nth": 0
            }
          ],
          "timeoutMs": 5000
        },
        "then": [
          {
            "action": "click",
            "id": "taobao_ads_item_promotion_rpa:关闭营销弹窗-点击关闭",
            "target": [
              {
                "by": "css",
                "value": ".next-dialog-close",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'next-dialog') or contains(@class,'next-overlay')]//*[contains(@class,'next-dialog-close') or contains(@class,'close')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ".ant-modal-close, .semi-modal-close, [role='dialog'] button[aria-label='Close'], [role='dialog'] button[aria-label='关闭']",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'modal') or contains(@class,'dialog') or @role='dialog']//*[contains(@class,'close') or @aria-label='Close' or @aria-label='关闭' or @title='关闭']",
                "nth": 0
              }
            ],
            "timeoutMs": 5000,
            "retries": 1,
            "onError": "continue"
          },
          {
            "action": "waitTimeout",
            "ms": 1000,
            "id": "taobao_ads_item_promotion_rpa:关闭营销弹窗-等待关闭"
          }
        ],
        "onError": "continue"
      },
      {
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//button[.//span[normalize-space(.)='下载报表'] or normalize-space(.)='下载报表']",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'商品数据明细') or contains(normalize-space(.),'商品报表')]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 15000,
        "onError": "continue",
        "id": "taobao_ads_item_promotion_rpa:wait-report-ready",
        "optional": true
      },
      {
        "action": "scrollIntoView",
        "target": [
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'商品数据明细') or contains(normalize-space(.),'商品报表')]",
            "nth": 0
          }
        ],
        "timeoutMs": 8000,
        "onError": "continue",
        "id": "taobao_ads_item_promotion_rpa:scroll-item-detail"
      },
      {
        "action": "scrollIntoView",
        "target": [
          {
            "by": "xpath",
            "value": "(//*[contains(normalize-space(.),'商品数据明细') or contains(normalize-space(.),'商品报表')]/following::button[.//span[normalize-space(.)='下载报表'] or normalize-space(.)='下载报表'])[1]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//button[.//span[normalize-space(.)='下载报表'] or normalize-space(.)='下载报表']",
            "nth": 0
          }
        ],
        "timeoutMs": 8000,
        "onError": "continue",
        "id": "taobao_ads_item_promotion_rpa:scroll-download-report"
      },
      {
        "action": "when",
        "id": "taobao_ads_item_promotion_rpa:关闭营销弹窗-下载前兜底",
        "condition": {
          "kind": "element",
          "state": "visible",
          "target": [
            {
              "by": "css",
              "value": ".next-dialog-close",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//*[contains(@class,'next-dialog') or contains(@class,'next-overlay')]//*[contains(@class,'next-dialog-close') or contains(@class,'close')]",
              "nth": 0
            },
            {
              "by": "css",
              "value": ".ant-modal-close, .semi-modal-close, [role='dialog'] button[aria-label='Close'], [role='dialog'] button[aria-label='关闭']",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//*[contains(@class,'modal') or contains(@class,'dialog') or @role='dialog']//*[contains(@class,'close') or @aria-label='Close' or @aria-label='关闭' or @title='关闭']",
              "nth": 0
            }
          ],
          "timeoutMs": 5000
        },
        "then": [
          {
            "action": "click",
            "id": "taobao_ads_item_promotion_rpa:关闭营销弹窗-下载前兜底-点击关闭",
            "target": [
              {
                "by": "css",
                "value": ".next-dialog-close",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'next-dialog') or contains(@class,'next-overlay')]//*[contains(@class,'next-dialog-close') or contains(@class,'close')]",
                "nth": 0
              },
              {
                "by": "css",
                "value": ".ant-modal-close, .semi-modal-close, [role='dialog'] button[aria-label='Close'], [role='dialog'] button[aria-label='关闭']",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "//*[contains(@class,'modal') or contains(@class,'dialog') or @role='dialog']//*[contains(@class,'close') or @aria-label='Close' or @aria-label='关闭' or @title='关闭']",
                "nth": 0
              }
            ],
            "timeoutMs": 5000,
            "retries": 1,
            "onError": "continue"
          },
          {
            "action": "waitTimeout",
            "ms": 1000,
            "id": "taobao_ads_item_promotion_rpa:关闭营销弹窗-下载前兜底-等待关闭"
          }
        ],
        "description": "下载前再次检测并关闭营销弹窗，防止延迟出现的弹窗遮挡「下载报表」。仅在 when 条件命中时点击，onError=continue。",
        "onError": "continue"
      },
      {
        "action": "click",
        "target": [
          {
            "by": "xpath",
            "value": "(//*[contains(normalize-space(.),'商品数据明细') or contains(normalize-space(.),'商品报表')]/following::button[.//span[normalize-space(.)='下载报表'] or normalize-space(.)='下载报表'])[1]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//button[.//span[normalize-space(.)='下载报表'] or normalize-space(.)='下载报表']",
            "nth": 0
          }
        ],
        "timeoutMs": 10000,
        "id": "taobao_ads_item_promotion_rpa:click-download-report",
        "retries": 2,
        "description": "下载报表点击使用已声明的两次重试，并保留前置弹窗关闭步骤。点击与下载确认均为 onError=fail，实际失败仍停止本任务。"
      },
      {
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='下载报表']/ancestor::*[contains(@class,'dialog') or contains(@class,'modal') or contains(@class,'overlay') or contains(@class,'next-dialog') or contains(@class,'mx-dialog')][1]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='下载报表' and (.//*[contains(normalize-space(.),'日期范围')] or .//*[contains(normalize-space(.),'文件名称')])]",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 10000,
        "onError": "continue",
        "id": "taobao_ads_item_promotion_rpa:wait-download-dialog",
        "recovery": "auto",
        "optional": true
      },
      {
        "action": "type",
        "target": [
          {
            "by": "xpath",
            "value": "//*[contains(@class,'dialog') or contains(@class,'modal') or contains(@class,'overlay') or @role='dialog'][.//*[contains(normalize-space(.),'文件名称')]]//input[not(@type) or @type='text']",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[contains(normalize-space(.),'文件名称')]/following::input[1]",
            "nth": 0
          }
        ],
        "value": "商品报表_{runId}",
        "clear": true,
        "timeoutMs": 10000,
        "retries": 1,
        "onError": "fail",
        "id": "taobao_ads_item_promotion_rpa:set-unique-report-name",
        "recovery": "auto"
      },
      {
        "action": "click",
        "target": [
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='下载报表']/ancestor::*[contains(@class,'dialog') or contains(@class,'modal') or contains(@class,'overlay') or contains(@class,'next-dialog') or contains(@class,'mx-dialog')][1]//button[.//span[normalize-space(.)='确定'] or normalize-space(.)='确定'])[last()]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='下载报表' and (.//*[contains(normalize-space(.),'日期范围')] or .//*[contains(normalize-space(.),'文件名称')])]//button[.//span[normalize-space(.)='确定'] or normalize-space(.)='确定'])[last()]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//button[.//span[normalize-space(.)='确定'] or normalize-space(.)='确定'])[last()]",
            "nth": 0
          }
        ],
        "timeoutMs": 10000,
        "retries": 1,
        "onError": "fail",
        "id": "taobao_ads_item_promotion_rpa:confirm-download-dialog"
      },
      {
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//*[contains(@class,'dialog') or contains(@class,'modal') or contains(@class,'overlay') or @role='dialog'][.//*[contains(normalize-space(.),'文件名称')]]//input[not(@type) or @type='text']",
            "nth": 0
          }
        ],
        "state": "hidden",
        "timeoutMs": 30000,
        "onError": "continue",
        "id": "taobao_ads_item_promotion_rpa:wait-download-request-accepted",
        "optional": true
      },
      {
