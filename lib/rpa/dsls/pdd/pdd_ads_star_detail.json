{
  "schemaVersion": "multi-platform-rpa-execution-new.dsl-spec.v1",
  "id": "pdd_ads_star_detail",
  "verified": false,
  "domains": [
    "运营推广"
  ],
  "platform": "pdd",
  "description": "只读进入明星店铺报表页，通过参数 start/end 填充 URL 中的昨日 beginDate/endDate，选择昨日后分别下载推广品牌词和创意汇总；不生成下载任务，不进入投放配置页面。",
  "conditions": {
    "time": {
      "kind": "range",
      "bindings": {
        "{start}": "$condition.start",
        "{end}": "$condition.end"
      },
      "dateConstraints": {
        "start": "start",
        "end": "end",
        "days": 1,
        "endOffsetDays": -1,
        "timezone": "Asia/Shanghai"
      }
    }
  },
  "template": {
    "schemaVersion": "agentwork.rpa.atomic.v1",
    "name": "拼多多广告-明星店铺-汇总数据",
    "description": "只读进入明星店铺报表页，通过参数 start/end 填充 URL 中的昨日 beginDate/endDate，选择昨日后分别下载推广品牌词和创意汇总；不生成下载任务，不进入投放配置页面。",
    "defaults": {
      "timeoutMs": 15000,
      "retries": 0,
      "continueOnError": false,
      "stepGapMs": 200
    },
    "steps": [
      {
        "id": "pdd-star-detail:打开明星店铺报表页",
        "action": "goto",
        "url": "https://yingxiao.pinduoduo.com/starmall/report/overView?beginDate={start}&endDate={end}",
        "waitUntil": "domcontentloaded",
        "timeoutMs": 60000,
        "after": [
          {
            "action": "waitFor",
            "optional": true,
            "id": "pdd.generic.dismiss-dialog",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "state": "visible",
            "timeoutMs": 10000,
            "onError": "continue",
            "retries": 0
          },
          {
            "action": "click",
            "optional": true,
            "id": "pdd.generic.dismiss-dialog.click",
            "target": [
              {
                "by": "css",
                "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
                "nth": 0
              }
            ],
            "onError": "continue",
            "retries": 0,
            "timeoutMs": 1000
          }
        ]
      },
      {
        "id": "pdd-star-detail:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效",
        "action": "assertElement",
        "state": "detached",
        "target": [
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='扫码登录'][not(.//*[normalize-space(.)='扫码登录'])]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='账户登录'][not(.//*[normalize-space(.)='账户登录'])]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='账号登录'][not(.//*[normalize-space(.)='账号登录'])]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='手机号登录'][not(.//*[normalize-space(.)='手机号登录'])]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='验证码登录'][not(.//*[normalize-space(.)='验证码登录'])]",
            "nth": 0
          }
        ],
        "timeoutMs": 5000,
        "onError": "fail",
        "description": "登录态短路守卫：命中登录页文本即判定登录失效且不重试。"
      },
      {
        "id": "pdd-star-detail:选择昨日",
        "action": "click",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'DateAreaV2_wrapper')]//*[@data-testid='DateAreaQuickOption_1'][normalize-space(.)='昨日']"
          }
        ],
        "timeoutMs": 20000,
        "onError": "fail"
      },
      {
        "id": "pdd-star-detail:确认主日期区间为冻结昨日",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'DateAreaV2_wrapper')][.//input[@placeholder='开始日期'][translate(@value,'/','-')='{start}']][.//input[@placeholder='结束日期'][translate(@value,'/','-')='{end}']]"
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "recovery": "auto",
        "optional": true
      },
      {
        "id": "pdd-star-detail:等待数据明细模块",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//*[normalize-space(.)='数据明细']",
            "nth": 0
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "recovery": "auto",
        "optional": true
      },
      {
        "id": "pdd-star-detail:切换推广品牌词",
        "action": "click",
        "target": [
          {
            "by": "xpath",
            "value": "//div[@role='tab'][normalize-space(.)='推广品牌词'][contains(@aria-controls,'-panel-unit')]"
          }
        ],
        "timeoutMs": 20000,
        "onError": "fail"
      },
      {
        "id": "pdd-star-detail:确认推广品牌词选中",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//div[@role='tab'][normalize-space(.)='推广品牌词'][contains(@aria-controls,'-panel-unit')][@aria-selected='true']"
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "recovery": "auto",
        "optional": true
      },
      {
        "id": "pdd-star-detail:等待品牌词表格刷新",
        "action": "waitTimeout",
        "ms": 1000
      },
      {
        "id": "pdd-star-detail:确认品牌词表头已刷新",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'ReportTable_wrap')]//thead//th[normalize-space(.)='推广']"
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "recovery": "auto",
        "optional": true
      },
      {
        "id": "pdd-star-detail:滚动到数据明细下载",
        "action": "scrollIntoView",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'ReportTable_wrap')][.//*[@role='tab'][@aria-selected='true']]//div[contains(@class,'ReportTable_operationWrap')]//button[span[normalize-space(.)='下载']]",
            "nth": 0
          },
          {
            "by": "xpath",
            "value": "(//*[normalize-space(.)='数据明细']/following::*[self::button or @role='button'][normalize-space(.)='下载' or .//*[normalize-space(.)='下载']])[1]",
            "nth": 0
          }
        ],
        "timeoutMs": 20000,
        "onError": "fail",
        "recovery": "auto"
      },
      {
        "id": "pdd_ads_star_detail:read-period-url",
        "action": "readPageUrl",
        "outputKey": "collection_period_url",
        "description": "保留下载前的实际页面日期 URL，CLI据此核对采集期间，延迟导入不重新计算昨天。"
      },
      {
        "id": "pdd-star-detail:品牌词下载按钮禁用则跳过",
        "action": "if",
        "condition": {
          "target": [
            {
              "by": "xpath",
              "value": "//div[contains(@class,'ReportTable_wrap')][.//*[@role='tab'][@aria-selected='true']]//div[contains(@class,'ReportTable_operationWrap')]//button[span[normalize-space(.)='下载']]",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "(//*[normalize-space(.)='数据明细']/following::*[self::button or @role='button'][normalize-space(.)='下载' or .//*[normalize-space(.)='下载']])[1]",
              "nth": 0
            }
          ],
          "state": "disabled",
          "timeoutMs": 0,
          "kind": "element"
        },
        "onError": "fail",
        "retries": 0,
        "recovery": "none",
        "description": "品牌词下载按钮禁用时跳过该文件，不点击、不重试；未禁用时执行下载。",
        "then": [
          {
            "id": "pdd-star-detail:品牌词下载按钮禁用时跳过",
            "action": "waitTimeout",
            "ms": 0,
            "retries": 0,
            "onError": "fail",
            "recovery": "none"
          }
        ],
        "else": [
          {
            "id": "pdd-star-detail:直接下载数据明细",
            "action": "downloadFile",
            "target": [
              {
                "by": "xpath",
                "value": "//div[contains(@class,'ReportTable_wrap')][.//*[@role='tab'][@aria-selected='true']]//div[contains(@class,'ReportTable_operationWrap')]//button[span[normalize-space(.)='下载']]",
                "nth": 0
              },
              {
                "by": "xpath",
                "value": "(//*[normalize-space(.)='数据明细']/following::*[self::button or @role='button'][normalize-space(.)='下载' or .//*[normalize-space(.)='下载']])[1]",
                "nth": 0
              }
            ],
            "timeoutMs": 60000,
            "retries": 0,
            "onError": "fail",
            "outputKey": "pddAdsStarSummaryFile"
          }
        ]
      },
      {
        "id": "pdd-star-detail:切换创意",
        "action": "click",
        "target": [
          {
            "by": "xpath",
            "value": "//div[@role='tab'][normalize-space(.)='创意'][contains(@aria-controls,'-panel-creative')]"
          }
        ],
        "timeoutMs": 20000,
        "onError": "fail"
      },
      {
        "id": "pdd-star-detail:确认创意选中",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//div[@role='tab'][normalize-space(.)='创意'][contains(@aria-controls,'-panel-creative')][@aria-selected='true']"
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "recovery": "auto",
        "optional": true
      },
      {
        "id": "pdd-star-detail:等待创意表格刷新",
        "action": "waitTimeout",
        "ms": 1000
      },
      {
        "id": "pdd-star-detail:确认创意表头已刷新",
        "action": "waitFor",
        "target": [
          {
            "by": "xpath",
            "value": "//div[contains(@class,'ReportTable_wrap')]//thead//th[normalize-space(.)='创意']"
          }
        ],
        "state": "visible",
        "timeoutMs": 20000,
        "onError": "continue",
        "recovery": "auto",
        "optional": true
      },
      {
        "id": "pdd-star-detail:创意下载按钮禁用则跳过",
        "action": "if",
        "condition": {
          "target": [
            {
              "by": "xpath",
              "value": "//div[contains(@class,'ReportTable_wrap')][.//*[@role='tab'][@aria-selected='true']]//div[contains(@class,'ReportTable_operationWrap')]//button[span[normalize-space(.)='下载']]"
            }
          ],
          "state": "disabled",
          "timeoutMs": 0,
          "kind": "element"
        },
        "onError": "fail",
        "retries": 0,
        "recovery": "none",
        "description": "创意下载按钮禁用时跳过该文件，不点击、不重试；未禁用时执行下载。",
        "then": [
          {
            "id": "pdd-star-detail:创意下载按钮禁用时跳过",
            "action": "waitTimeout",
            "ms": 0,
            "retries": 0,
            "onError": "fail",
            "recovery": "none"
          }
        ],
        "else": [
          {
            "id": "pdd-star-detail:直接下载创意明细",
            "action": "downloadFile",
            "target": [
              {
                "by": "xpath",
                "value": "//div[contains(@class,'ReportTable_wrap')][.//*[@role='tab'][@aria-selected='true']]//div[contains(@class,'ReportTable_operationWrap')]//button[span[normalize-space(.)='下载']]"
              }
            ],
            "timeoutMs": 60000,
            "retries": 0,
            "onError": "fail",
            "outputKey": "pddAdsStarCreativeSummaryFile"
          }
        ]
      }
    ]
  },
  "compatibility": {
    "import": {
      "mode": "downloads",
      "businessDate": "prepared",
      "requiredSteps": [
        "pdd-star-detail:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效",
        "pdd_ads_star_detail:read-period-url"
      ],
      "files": [
        {
          "stepId": "pdd-star-detail:直接下载数据明细",
          "outputKey": "pddAdsStarSummaryFile",
          "skipWhen": {
            "reason": "button_disabled",
            "control_step_id": "pdd-star-detail:品牌词下载按钮禁用则跳过",
            "step_id": "pdd-star-detail:品牌词下载按钮禁用时跳过",
            "download_step_id": "pdd-star-detail:直接下载数据明细",
            "required_steps": [
              {
                "step_id": "pdd-star-detail:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效",
                "action": "assertElement"
              },
              {
                "step_id": "pdd-star-detail:选择昨日",
                "action": "click"
              },
              {
                "step_id": "pdd_ads_star_detail:read-period-url",
                "action": "readPageUrl"
              },
              {
                "step_id": "pdd-star-detail:切换推广品牌词",
                "action": "click"
              }
            ]
          }
        },
        {
          "stepId": "pdd-star-detail:直接下载创意明细",
          "outputKey": "pddAdsStarCreativeSummaryFile",
          "skipWhen": {
            "reason": "button_disabled",
            "control_step_id": "pdd-star-detail:创意下载按钮禁用则跳过",
            "step_id": "pdd-star-detail:创意下载按钮禁用时跳过",
            "download_step_id": "pdd-star-detail:直接下载创意明细",
            "required_steps": [
              {
                "step_id": "pdd-star-detail:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效",
                "action": "assertElement"
              },
              {
                "step_id": "pdd-star-detail:选择昨日",
                "action": "click"
              },
              {
                "step_id": "pdd_ads_star_detail:read-period-url",
                "action": "readPageUrl"
              },
              {
                "step_id": "pdd-star-detail:切换创意",
                "action": "click"
              }
            ]
          }
        }
      ],
      "urlPeriod": {
        "outputKey": "collection_period_url",
        "startParameter": "beginDate",
        "endParameter": "endDate"
      }
    }
  },
  "collection": {
    "schedule": {
      "mode": "period",
      "days": 1,
      "end_offset_days": -1
    },
    "capabilities": {
      "after": [
        "pdd_decrypt"
      ]
    },
    "artifacts": [
      {
        "role": "business",
        "kind": "download_ref",
        "output_key": "pddAdsStarSummaryFile",
        "skip_when": {
          "reason": "button_disabled",
          "control_step_id": "pdd-star-detail:品牌词下载按钮禁用则跳过",
          "step_id": "pdd-star-detail:品牌词下载按钮禁用时跳过",
          "download_step_id": "pdd-star-detail:直接下载数据明细",
          "required_steps": [
            {
              "step_id": "pdd-star-detail:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效",
              "action": "assertElement"
            },
            {
              "step_id": "pdd-star-detail:选择昨日",
              "action": "click"
            },
            {
              "step_id": "pdd_ads_star_detail:read-period-url",
              "action": "readPageUrl"
            },
            {
              "step_id": "pdd-star-detail:切换推广品牌词",
              "action": "click"
            }
          ]
        }
      },
      {
        "role": "business",
        "kind": "download_ref",
        "output_key": "pddAdsStarCreativeSummaryFile",
        "skip_when": {
          "reason": "button_disabled",
          "control_step_id": "pdd-star-detail:创意下载按钮禁用则跳过",
          "step_id": "pdd-star-detail:创意下载按钮禁用时跳过",
          "download_step_id": "pdd-star-detail:直接下载创意明细",
          "required_steps": [
            {
              "step_id": "pdd-star-detail:LOGIN_REQUIRED__do-not-retry__未登录或登录态失效",
              "action": "assertElement"
            },
            {
              "step_id": "pdd-star-detail:选择昨日",
              "action": "click"
            },
            {
              "step_id": "pdd_ads_star_detail:read-period-url",
              "action": "readPageUrl"
            },
            {
              "step_id": "pdd-star-detail:切换创意",
              "action": "click"
            }
          ]
        }
      }
    ]
  }
}
