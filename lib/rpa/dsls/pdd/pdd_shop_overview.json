{
  "schemaVersion": "agentwork.rpa.atomic.v1",
  "id": "pdd_shop_overview",
  "platform": "pdd",
  "name": "PDD-后台首页-页面采集",
  "description": "Read-only PDD 后台首页 page collection. One page, one goto.",
  "defaults": {
    "timeoutMs": 8000,
    "retries": 1,
    "continueOnError": true,
    "stepGapMs": 300
  },
  "steps": [
    {
      "action": "goto",
      "id": "打开后台首页",
      "url": "https://mms.pinduoduo.com/home/",
      "waitUntil": "domcontentloaded",
      "after": [
        {
          "action": "waitFor",
          "optional": true,
          "id": "pdd.dismiss-known-dialog",
          "target": [
            {
              "by": "css",
              "value": "#umd-msgbox-handler i.ImportantList_close__d0eKb",
              "nth": 0
            },
            {
              "by": "css",
              "value": "div[class*='ImportantList_msgbox'] i[class*='close']",
              "nth": 0
            },
            {
              "by": "css",
              "value": "[class*='close-modal']",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//div[contains(@class,'ImportantList_msgbox')]//i[contains(@class,'close')]",
              "nth": 0
            },
            {
              "by": "css",
              "value": "[class*='NewMsgBox_'] [class*='close']",
              "nth": 0
            },
            {
              "by": "css",
              "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
              "nth": 0
            }
          ],
          "state": "visible",
          "timeoutMs": 10000,
          "onError": "continue",
          "retries": 0
        },
        {
          "action": "click",
          "optional": true,
          "id": "pdd.dismiss-known-dialog.click",
          "target": [
            {
              "by": "css",
              "value": "#umd-msgbox-handler i.ImportantList_close__d0eKb",
              "nth": 0
            },
            {
              "by": "css",
              "value": "div[class*='ImportantList_msgbox'] i[class*='close']",
              "nth": 0
            },
            {
              "by": "css",
              "value": "[class*='close-modal']",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "//div[contains(@class,'ImportantList_msgbox')]//i[contains(@class,'close')]",
              "nth": 0
            },
            {
              "by": "css",
              "value": "[class*='NewMsgBox_'] [class*='close']",
              "nth": 0
            },
            {
              "by": "css",
              "value": ":is([class*='-dialog'], [class*='dialog-'], [class*='-modal'], [class*='modal-'], [class*='dialog'][class*='wrapper'], [class*='modal'][class*='wrapper']) :is([class*='-close'], [class*='close-'])",
              "nth": 0
            }
          ],
          "onError": "continue",
          "retries": 0,
          "timeoutMs": 1000
        }
      ]
    },
    {
      "action": "waitTimeout",
      "id": "等待首页渲染",
      "ms": 2500
    },
    {
      "action": "click",
      "id": "关闭新消息浮窗(首页)",
      "target": [
        {
          "by": "css",
          "value": "i.ImportantList_close__d0eKb",
          "nth": 0
        },
        {
          "by": "css",
          "value": "div[class*=\"ImportantList_msgbox\"] i[class*=\"close\"]",
          "nth": 0
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class,'ImportantList_msgbox')]//i[contains(@class,'close')]",
          "nth": 0
        }
      ],
      "timeoutMs": 2000,
      "optional": true,
      "onError": "continue"
    },
    {
      "action": "waitTimeout",
      "id": "等待浮窗关闭动画(首页)",
      "ms": 500
    },
    {
      "action": "readText",
      "id": "读取后台首页文本",
      "target": [
        {
          "by": "css",
          "value": "body",
          "nth": 0
        }
      ],
      "readMode": "innerText",
      "trim": true,
      "outputKey": "home_text",
      "recovery": "auto"
    }
  ],
  "collection": {
    "capabilities": {
      "after": [
        "pdd_decrypt"
      ]
    },
    "artifacts": [
      {
        "role": "business",
        "kind": "raw_envelope",
        "pointer": ""
      }
    ]
  }
}
