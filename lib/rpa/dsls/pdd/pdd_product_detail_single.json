        {
          "action": "readText",
          "id": "读取数据明细卡片区",
          "target": [
            {
              "by": "xpath",
              "value": "//div[contains(@class,'product-detail-chart_wrapper')]//div[contains(@class,'product-detail-chart_detailCardWrapper__')]"
            }
          ],
          "readMode": "innerText",
          "trim": true,
          "timeoutMs": 8000,
          "outputKey": "pdd_single_product_detail_cards_text",
          "recovery": "auto"
        },
        {
          "action": "readText",
          "id": "读取评价数据区",
          "target": [
            {
              "by": "xpath",
              "value": "(//div[contains(@class,'product-detail-chart_wrapper')]//*[contains(normalize-space(.),'评价数据')])[last()]"
            }
          ],
          "readMode": "innerText",
          "trim": true,
          "timeoutMs": 6000,
          "onError": "continue",
          "outputKey": "pdd_single_product_review_text"
        },
        {
          "action": "readText",
          "id": "读取售后数据区",
          "target": [
            {
              "by": "xpath",
              "value": "(//div[contains(@class,'product-detail-chart_wrapper')]//*[contains(normalize-space(.),'售后数据')])[last()]"
            }
          ],
          "readMode": "innerText",
          "trim": true,
          "timeoutMs": 6000,
          "onError": "continue",
          "outputKey": "pdd_single_product_after_sale_text"
        },
        {
          "action": "readText",
          "id": "读取商品领航员区",
          "target": [
            {
              "by": "xpath",
              "value": "(//div[contains(@class,'product-detail-chart_wrapper')]//*[contains(normalize-space(.),'领航员')])[last()]"
            }
          ],
          "readMode": "innerText",
          "trim": true,
          "timeoutMs": 6000,
          "onError": "continue",
          "outputKey": "pdd_single_product_navigator_text"
        },
        {
          "action": "readText",
          "id": "读取分析建议区",
          "target": [
            {
              "by": "css",
              "value": "[class*='product-detail-chart_wrapper'] [class*='analysisContent'], [class*='product-detail-chart_wrapper'] [class*='analysis_content']",
              "nth": 0
            },
            {
              "by": "xpath",
              "value": "(//div[contains(@class,'product-detail-chart_wrapper')]//*[contains(normalize-space(.),'分析建议')])[last()]"
            }
          ],
          "readMode": "innerText",
          "trim": true,
          "timeoutMs": 6000,
          "onError": "continue",
          "outputKey": "pdd_single_product_advice_text"
        }
      ],
      "else": [
        {
          "action": "readText",
          "id": "pdd_single_product:read-empty-page",
          "target": [
            {
              "by": "css",
              "value": "body",
              "nth": 0
            }
          ],
          "readMode": "innerText",
          "trim": true,
          "outputKey": "pdd_product_detail_single_empty_page_text",
          "recovery": "auto"
        },
        {
          "action": "queryAll",
