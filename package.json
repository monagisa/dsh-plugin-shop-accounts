{
  "name": "dsh-plugin-shop-accounts",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "description": "DSH 插件：电商平台店铺账号管理（拼多多 / 淘宝 / 天猫 / 抖音 / 京东 / 1688，都是商家端）——一个店铺一份独立登录档案，登录一次长期复用，上架时直接挑选；浏览器优先 ego lite（每店一个 profile + TaskSpace），未安装时回退 Chrome CDP；v0.10.0 起支持 macOS（钥匙串加密密码、Finder 打开档案、.app 内浏览器路径）",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "ecommerce",
    "chrome",
    "cdp",
    "ego",
    "egolite",
    "macos"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "test"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "smoke": "node test/smoke.mjs",
    "features": "node test/features-v090.mjs",
    "features2": "node test/features-v0101.mjs",
    "platform": "node test/platform.mjs",
    "test": "node test/smoke.mjs && node test/features-v090.mjs && node test/features-v0101.mjs && node test/platform.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
